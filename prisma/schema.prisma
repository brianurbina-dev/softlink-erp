generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id            String           @id @default(cuid())
  rut           String           @unique
  razonSocial   String           @map("razon_social")
  giro          String?
  logoUrl       String?          @map("logo_url")
  telefono      String?
  emailContacto String?          @map("email_contacto")
  web           String?
  direccion     String?
  ciudad        String?
  actividadesEconomicas Int[]    @default([]) @map("actividades_economicas")
  schemaName    String           @unique @map("schema_name")
  plan          String           @default("starter")
  activa        Boolean          @default(true)
  creadaEn      DateTime         @default(now()) @map("creada_en")
  dteConfig     DteConfig?
  usuarios      EmpresaUsuario[]

  @@map("empresas")
}

model Usuario {
  id         String           @id @default(cuid())
  authUserId String           @unique @map("auth_user_id")
  email      String           @unique
  nombre     String
  rolGlobal  String           @default("user") @map("rol_global")
  creadoEn   DateTime         @default(now()) @map("creado_en")
  empresas   EmpresaUsuario[]

  @@map("usuarios")
}

model EmpresaUsuario {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  usuarioId String   @map("usuario_id")
  rol       String   @default("admin")
  permisos  String[] @default([])
  activo    Boolean  @default(true)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([empresaId, usuarioId])
  @@map("empresa_usuario")
}

model DteConfig {
  id                  String  @id @default(cuid())
  empresaId           String  @unique @map("empresa_id")
  proveedor           String  @default("simpleapi")
  apiKey              String? @map("api_key")
  certificado         String?
  certificadoNombre   String? @map("certificado_nombre")
  certificadoPassword String? @map("certificado_password")
  ambiente            String  @default("certificacion")
  numeroResolucion    Int?    @default(0) @map("numero_resolucion")
  fechaResolucion     String? @map("fecha_resolucion")
  rutCertificado      String? @map("rut_certificado")
  empresa             Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("dte_config")
}
